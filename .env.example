# Copy to .env.local and fill in. NEVER commit .env.local (see .gitignore).

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Public URL the MCP server is reachable at (used for OAuth redirect + MCP metadata)
MCP_PUBLIC_URL=http://localhost:3000

# --- Postgres (Railway-provisioned; choose an EU region — see README RGPD note) ---
DATABASE_URL=postgres://user:password@localhost:5432/gtm

# --- Token encryption (ADR 0003) ---
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (internal dayuse.com app, ADR 0003) ---
# Scopes requested: tagmanager.edit.containers + tagmanager.readonly — NO publish scope.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- GTM containers (one account, two containers — ADR 0004 / Q8) ---
GTM_ACCOUNT_ID=
GTM_WEB_CONTAINER_ID=
GTM_SERVER_CONTAINER_ID=

# --- Ops (Q18) ---
GOOGLE_CHAT_WEBHOOK_URL=
# Auto-reject pending changesets older than this many hours (frees a workspace slot — ADR 0005)
PENDING_CHANGESET_TTL_HOURS=72
